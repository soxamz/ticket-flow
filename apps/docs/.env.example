# Environment Variables
# Copy this file to .env.local and fill in the values.

# Public URL for canonical metadata (used by docs app)
# NEXT_PUBLIC_SITE_URL=https://docs.example.com

# GitHub repository for "Edit on GitHub" links in docs (format: owner/repo)
# NEXT_PUBLIC_GITHUB_REPO=your-username/next-turbo-starter

# GitHub branch for source links (defaults to "main")
# NEXT_PUBLIC_GITHUB_BRANCH=main
